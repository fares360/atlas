              disabled
                ? "bg-[#E6E2D3] text-[#A8A290]"
                : "bg-[#2A5B68] text-white group-hover:bg-[#1f4a56]"
            )}
          >
            {disabled ? (
              <Lock className="w-6 h-6" />
            ) : (
              <BookOpen className="w-6 h-6" />
            )}
          </div>
          <div>
            <h3
              className={cn(
                "text-xl font-bold font-serif mb-1 leading-tight",
                disabled ? "text-[#8C8C8C]" : "text-[#3E2723]"
