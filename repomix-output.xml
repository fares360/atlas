                <User className="h-4 w-4" />
                <span>تسجيل الدخول</span>
              </Link>
            </div>
          </div>
        )}
      </header>

      <SearchModal
        isOpen={isSearchOpen}
        onClose={() => setIsSearchOpen(false)}
      />
    </>
  );
