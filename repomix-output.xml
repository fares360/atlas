                <ArrowLeft className="w-4 h-4" />
              </div>
            </>
          )}
        </div>
      </div>
    </>
  );

  if (disabled) {
    return <div className={cardClasses}>{CardContent}</div>;
  }

  return (
    <Link href={href || "#"} className={cardClasses}>
      {CardContent}
    </Link>
  );
}
